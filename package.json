{
  "name": "chat-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rm -rf packages/*/dist packages/sources/*/dist packages/sinks/*/dist packages/*/*.tsbuildinfo",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "guard": "agentic-guards run",
    "guard:legacy": "tsx guards/run-all.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:cli": "playwright test -c e2e/playwright.config.ts --project=cli",
    "bench": "tsx bench/bench.ts",
    "bench:compare": "tsx bench/compare.ts"
  },
  "devDependencies": {
    "@agentic-factory/guards": "^1.2.0",
    "@agentic-factory/harness": "^1.0.0",
    "@agentic-factory/loop": "^0.3.0",
    "@chat-bridge/testing": "workspace:*",
    "@chat-bridge/types": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3"
  }
}
